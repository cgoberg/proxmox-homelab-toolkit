#!/bin/bash
# forge-fanctl - temperature-driven PWM control for hosts fancontrol cannot address.
#
# Why this exists instead of fancontrol:
#   Profile B  f71882fg exposes attributes on the platform device, not under hwmon/hwmonN/,
#        which is the only addressing fancontrol understands.
#   Profile A  dell_smm exposes WRITE-ONLY pwm (reads return -ENODATA); fancontrol must read.
#
# Paths may be given literally, or as @hwmonname/attr which is resolved by hwmon
# 'name' each cycle so that hwmonN renumbering across reboots cannot mispoint us.
#
# Fails safe: on any exit fans are driven to SAFE_PWM.
set -u
CONF=${1:-/etc/forge-fanctl.conf}

# Parse only the data fields this controller understands. The service runs as
# root, so sourcing a configuration file or evaluating a command from it would
# turn a writable config into arbitrary code execution.
while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in ''|'#'*) continue ;; esac
    key=${line%%=*}
    value=${line#*=}
    [ "$key" != "$line" ] || { echo "invalid config line: $line" >&2; exit 2; }
    value=${value#\"}; value=${value%\"}
    case "$key" in
        TEMP_FILE|PWM_SPECS|MINTEMP|MAXTEMP|INTERVAL|SAFE_PWM)
            printf -v "$key" '%s' "$value" ;;
        *) echo "unsupported config key: $key" >&2; exit 2 ;;
    esac
done < "$CONF"

: "${INTERVAL:=10}"
: "${SAFE_PWM:=255}"

for number_name in INTERVAL SAFE_PWM MINTEMP MAXTEMP; do
    number_value=${!number_name:-}
    [[ "$number_value" =~ ^[0-9]+$ ]] || {
        echo "$number_name must be an unsigned integer" >&2
        exit 2
    }
done
(( INTERVAL > 0, SAFE_PWM <= 255, MINTEMP < MAXTEMP )) || {
    echo "unsafe numeric limits in fan-control config" >&2
    exit 2
}
[[ -n "${TEMP_FILE:-}" && -n "${PWM_SPECS:-}" ]] || {
    echo "TEMP_FILE and PWM_SPECS are required" >&2
    exit 2
}

resolve() {
    case "$1" in
        @*) local nm n attr d dn
            # NB: these must be separate assignments. In a single "local a=.. b=$a"
            # bash does not expose the earlier assignment to the later expansion,
            # which silently yielded an empty name and matched an unnamed hwmon.
            nm=${1#@}; n=${nm%%/*}; attr=${nm#*/}
            [[ "$n" =~ ^[A-Za-z0-9_.-]+$ ]] || { echo ""; return; }
            [[ "$attr" =~ ^(pwm[0-9]+|temp[0-9]+_input)$ ]] || { echo ""; return; }
            for d in /sys/class/hwmon/hwmon*; do
                dn=$(cat "$d/name" 2>/dev/null)
                # an unnamed hwmon must never match an empty parse
                [ -z "$dn" ] && continue
                if [ "$dn" = "$n" ]; then echo "$d/$attr"; return; fi
            done
            echo "" ;;
        *)
            [[ "$1" =~ ^/sys/devices/[A-Za-z0-9_./:-]+/(pwm[0-9]+|temp[0-9]+_input)$ ]] \
                && echo "$1" || echo "" ;;
    esac
}

for spec in $PWM_SPECS; do
    rest=${spec#*:}; lo=${rest%%:*}; hi=${rest##*:}
    [[ "$spec" == *:*:* && "$lo" =~ ^[0-9]+$ && "$hi" =~ ^[0-9]+$ ]] || {
        echo "invalid PWM specification" >&2
        exit 2
    }
    (( lo >= 0, lo <= hi, hi <= 255 )) || {
        echo "PWM limits must satisfy 0 <= minimum <= maximum <= 255" >&2
        exit 2
    }
    [ -n "$(resolve "${spec%%:*}")" ] || {
        echo "PWM target is not an allowed sysfs path" >&2
        exit 2
    }
done
[ -n "$(resolve "$TEMP_FILE")" ] || {
    echo "temperature target is not an allowed sysfs path" >&2
    exit 2
}

write_all() {
    local val=$1 spec f
    for spec in $PWM_SPECS; do
        f=$(resolve "${spec%%:*}")
        [ -n "$f" ] && echo "$val" > "$f" 2>/dev/null
    done
    return 0
}
trap 'write_all "$SAFE_PWM"; exit 0' EXIT INT TERM

# Put every controlled channel into manual mode. Done here rather than via
# config commands so configuration stays declarative. Chips with no *_enable
# node (e.g. dell_smm) simply skip.
ensure_manual() {
    local spec f
    for spec in $PWM_SPECS; do
        f=$(resolve "${spec%%:*}")
        [ -n "$f" ] && [ -e "${f}_enable" ] && echo 1 > "${f}_enable" 2>/dev/null
    done
    return 0
}
ensure_manual

while true; do
    ensure_manual
    tf=$(resolve "$TEMP_FILE")
    # Unreadable sensor must mean "assume hot", never "assume cold".
    raw=$(cat "$tf" 2>/dev/null || echo 95000)
    [ -z "$raw" ] && raw=95000
    t=$(( raw / 1000 ))

    for spec in $PWM_SPECS; do
        rest=${spec#*:}; lo=${rest%%:*}; hi=${rest##*:}
        f=$(resolve "${spec%%:*}")
        [ -z "$f" ] && continue
        if   [ "$t" -le "$MINTEMP" ]; then v=$lo
        elif [ "$t" -ge "$MAXTEMP" ]; then v=$hi
        else v=$(( lo + (t - MINTEMP) * (hi - lo) / (MAXTEMP - MINTEMP) ))
        fi
        echo "$v" > "$f" 2>/dev/null
    done
    sleep "$INTERVAL"
done
